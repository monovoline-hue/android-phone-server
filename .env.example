# Android Phone Server - cloud-side environment EXAMPLE
# Copy to a real env file / systemd Environment= lines and fill real values.
# NEVER commit the filled-in version.

# Sampling cadence the phone actually runs at (drives gap clipping in stats)
MI10PRO_POLL_SECONDS=300

# SSH timeout for pulls from the phone (seconds)
MI10PRO_SSH_TIMEOUT=20

# Path to adb on the cloud host (optional ADB battery supplement; usually unused)
# MI10PRO_ADB=/usr/bin/adb

# History retention for prune_history.py (days / hard line cap)
MI10PRO_KEEP_DAYS=30
MI10PRO_MAX_LINES=60000

# The phone is reached via the SSH config alias below - put the real
# Tailscale IP / user / key in ~/.ssh/config on the cloud host, not here.
# ~/.ssh/config:
#   Host mi10pro
#     HostName 100.x.y.z
#     Port 8022
#     User <termux-user>
#     IdentityFile ~/.ssh/<key>
